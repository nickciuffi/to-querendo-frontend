# Copie este arquivo para .env e preencha com valores reais.
# O .env nunca deve ser commitado (já está no .gitignore).

# --- Domínio / HTTPS ---
# O registro DNS (tipo A) do domínio deve apontar para o IP elástico da EC2
DOMAIN=seudominio.com.br
# E-mail para o Let's Encrypt (avisos sobre o certificado)
ACME_EMAIL=seu-email@exemplo.com

# --- Build do frontend ---
# Atenção: estas variáveis são embutidas no bundle no momento do build.
# Se mudar algum valor, rode de novo: docker compose up -d --build web

# URL pública da API (sem barra final): o nginx repassa /api para o backend
VITE_API_URL=https://seudominio.com.br/api

# Token público do Mapbox (pk....)
VITE_MAPBOX_TOKEN=pk.seu_token_aqui
